// Note that this is an X-macro header. It does not use `#include` guards, and
// instead is designed to be `#include`ed after the x-macro is defined in order
// for its inclusion to expand to the desired output.

#ifndef MYLANG_ENUM_BASE_TEST_KIND
#error "Must define the x-macro to use this file."
#define MYLANG_ENUM_BASE_TEST_KIND(Name)
#endif

MYLANG_ENUM_BASE_TEST_KIND(Beep)
MYLANG_ENUM_BASE_TEST_KIND(Boop)
MYLANG_ENUM_BASE_TEST_KIND(Burr)

#undef MYLANG_ENUM_BASE_TEST_KIND
