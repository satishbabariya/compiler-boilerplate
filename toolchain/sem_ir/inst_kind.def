//
// This is an X-macro header. It does not use `#include` guards, and instead is
// designed to be `#include`ed after the x-macro is defined in order for its
// inclusion to expand to the desired output. Macro definitions are cleaned up
// at the end of this file.
//
// This macro should be defined before including this header:
// - MYLANG_SEM_IR_INST_KIND(Name)
//   Invoked for each kind of semantic instruction.

#ifndef MYLANG_SEM_IR_INST_KIND
#error "Must define the x-macro to use this file."
#define MYLANG_SEM_IR_INST_KIND(Name)
#endif

// Core
MYLANG_SEM_IR_INST_KIND(ErrorInst)
MYLANG_SEM_IR_INST_KIND(Assign)

// Control flow
MYLANG_SEM_IR_INST_KIND(Branch)
MYLANG_SEM_IR_INST_KIND(BranchIf)
MYLANG_SEM_IR_INST_KIND(BranchWithArg)
MYLANG_SEM_IR_INST_KIND(Call)
MYLANG_SEM_IR_INST_KIND(Return)
MYLANG_SEM_IR_INST_KIND(ReturnExpr)

// Types
MYLANG_SEM_IR_INST_KIND(BoolType)
MYLANG_SEM_IR_INST_KIND(IntType)
MYLANG_SEM_IR_INST_KIND(FunctionType)
MYLANG_SEM_IR_INST_KIND(PointerType)
MYLANG_SEM_IR_INST_KIND(TypeType)

// Values
MYLANG_SEM_IR_INST_KIND(BoolLiteral)
MYLANG_SEM_IR_INST_KIND(IntValue)
MYLANG_SEM_IR_INST_KIND(IntLiteralType)

// Variables and bindings
MYLANG_SEM_IR_INST_KIND(VarStorage)
MYLANG_SEM_IR_INST_KIND(NameRef)
MYLANG_SEM_IR_INST_KIND(Namespace)
MYLANG_SEM_IR_INST_KIND(NamespaceType)
MYLANG_SEM_IR_INST_KIND(NameBindingDecl)
MYLANG_SEM_IR_INST_KIND(ValueBinding)
MYLANG_SEM_IR_INST_KIND(ValueBindingPattern)
MYLANG_SEM_IR_INST_KIND(ValueParam)
MYLANG_SEM_IR_INST_KIND(ValueParamPattern)

// Functions
MYLANG_SEM_IR_INST_KIND(FunctionDecl)

// Other essential
MYLANG_SEM_IR_INST_KIND(BlockArg)
MYLANG_SEM_IR_INST_KIND(SpliceBlock)
MYLANG_SEM_IR_INST_KIND(ImportDecl)
MYLANG_SEM_IR_INST_KIND(Converted)

// TODO: Add your language's semantic IR instructions here.

#undef MYLANG_SEM_IR_INST_KIND
