//
// This is an X-macro header. It does not use `#include` guards, and instead is
// designed to be `#include`ed after the x-macro is defined in order for its
// inclusion to expand to the desired output. Macro definitions are cleaned up
// at the end of this file.
//
// Supported x-macros are:
// - MYLANG_PARSE_NODE_KIND(Name)
//   Used as a fallback if other macros are missing. Also, used directly
//   when none of the below category-oriented macros apply.
//   - MYLANG_PARSE_NODE_KIND_PREFIX_OPERATOR(Name)
//     Defines a parse node for a prefix operator, with the Name as token.
//   - MYLANG_PARSE_NODE_KIND_INFIX_OPERATOR(Name)
//     Defines a parse node for an infix operator, with the Name as token.
//   - MYLANG_PARSE_NODE_KIND_POSTFIX_OPERATOR(Name)
//     Defines a parse node for a postfix operator, with the Name as token.
//   - MYLANG_PARSE_NODE_KIND_TOKEN_LITERAL(Name, LexTokenKind)
//     Defines a parse node that corresponds to a token that is a single-token
//     literal.
//   - MYLANG_PARSE_NODE_KIND_TOKEN_MODIFIER(Name)
//     A token-based modifier. The Name is the TokenKind, and will be appended
//     with "Modifier" for the parse kind.
//
// LexTokenKind indicates the token kind required on a valid node.
//
// Parse nodes are clustered based on language feature. See typed_nodes.h for
// the expected tree structure under each node kind.

#if !defined(MYLANG_PARSE_NODE_KIND)
#error "Must define MYLANG_PARSE_NODE_KIND family x-macros to use this file."
#define MYLANG_PARSE_NODE_KIND(Name)
#endif

// This is expected to be used with something like:
//
//   // Use x-macros to handle modifier cases.
//   #define MYLANG_PARSE_NODE_KIND(Name)
//   #define MYLANG_PARSE_NODE_KIND_PREFIX_OPERATOR(Name) <code>
#ifndef MYLANG_PARSE_NODE_KIND_PREFIX_OPERATOR
#define MYLANG_PARSE_NODE_KIND_PREFIX_OPERATOR(Name) \
  MYLANG_PARSE_NODE_KIND(PrefixOperator##Name)
#endif

// This is expected to be used with something like:
//
//   // Use x-macros to handle modifier cases.
//   #define MYLANG_PARSE_NODE_KIND(Name)
//   #define MYLANG_PARSE_NODE_KIND_INFIX_OPERATOR(Name) <code>
#ifndef MYLANG_PARSE_NODE_KIND_INFIX_OPERATOR
#define MYLANG_PARSE_NODE_KIND_INFIX_OPERATOR(Name) \
  MYLANG_PARSE_NODE_KIND(InfixOperator##Name)
#endif

// This is expected to be used with something like:
//
//   // Use x-macros to handle modifier cases.
//   #define MYLANG_PARSE_NODE_KIND(Name)
//   #define MYLANG_PARSE_NODE_KIND_POSTFIX_OPERATOR(Name) <code>
#ifndef MYLANG_PARSE_NODE_KIND_POSTFIX_OPERATOR
#define MYLANG_PARSE_NODE_KIND_POSTFIX_OPERATOR(Name) \
  MYLANG_PARSE_NODE_KIND(PostfixOperator##Name)
#endif

// This is expected to be used with something like:
//
//   // Use x-macros to handle literal cases.
//   #define MYLANG_PARSE_NODE_KIND(Name)
//   #define MYLANG_PARSE_NODE_KIND_TOKEN_LITERAL(Name, LexTokenKind) <code>
#ifndef MYLANG_PARSE_NODE_KIND_TOKEN_LITERAL
#define MYLANG_PARSE_NODE_KIND_TOKEN_LITERAL(Name, LexTokenKind) \
  MYLANG_PARSE_NODE_KIND(Name)
#endif

// This is expected to be used with something like:
//
//   // Use x-macros to handle modifier cases.
//   #define MYLANG_PARSE_NODE_KIND(Name)
//   #define MYLANG_PARSE_NODE_KIND_TOKEN_MODIFIER(Name) <code>
#ifndef MYLANG_PARSE_NODE_KIND_TOKEN_MODIFIER
#define MYLANG_PARSE_NODE_KIND_TOKEN_MODIFIER(Name) \
  MYLANG_PARSE_NODE_KIND(Name##Modifier)
#endif

