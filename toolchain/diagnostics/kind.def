//
// Note that this is an X-macro header.
//
// It does not use `#include` guards, and instead is designed to be `#include`ed
// after some set of x-macros are defined in order for its inclusion to expand
// to the desired output.
//
// The viable X-macros to define prior to including the header are:
//
// - `MYLANG_DIAGNOSTIC_KIND`

#ifndef MYLANG_DIAGNOSTIC_KIND
#error "Must define the x-macro to use this file."
#define MYLANG_DIAGNOSTIC_KIND(Name)
#endif

// ============================================================================
// Driver and subcommand diagnostics
// ============================================================================

MYLANG_DIAGNOSTIC_KIND(DriverInstallInvalid)
MYLANG_DIAGNOSTIC_KIND(DriverRuntimesCacheInvalid)
MYLANG_DIAGNOSTIC_KIND(DriverPrebuiltRuntimesInvalid)
MYLANG_DIAGNOSTIC_KIND(DriverCommandLineParseFailed)
MYLANG_DIAGNOSTIC_KIND(CompilePhaseFlagConflict)
MYLANG_DIAGNOSTIC_KIND(CompilePreludeManifestError)
MYLANG_DIAGNOSTIC_KIND(CompileInputNotRegularFile)
MYLANG_DIAGNOSTIC_KIND(CompileOutputFileOpenError)
MYLANG_DIAGNOSTIC_KIND(CompileTargetInvalid)
MYLANG_DIAGNOSTIC_KIND(ConfigFailedToReadDigest)
MYLANG_DIAGNOSTIC_KIND(ConfigFailedToSetupTarget)
MYLANG_DIAGNOSTIC_KIND(FailureBuildingRuntimes)
MYLANG_DIAGNOSTIC_KIND(FailureRunningClang)
MYLANG_DIAGNOSTIC_KIND(FailureRunningClangToLink)
MYLANG_DIAGNOSTIC_KIND(FormatMultipleFilesToOneOutput)
MYLANG_DIAGNOSTIC_KIND(ToolFuzzingDisallowed)

