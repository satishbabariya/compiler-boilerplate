//
// This is an X-macro header. It does not use `#include` guards, and instead is
// designed to be `#include`ed after the x-macro is defined in order for its
// inclusion to expand to the desired output. Macro definitions are cleaned up
// at the end of this file.
//
// Supported x-macros are:
// - MYLANG_TOKEN(Name)
//   Defines a token. Used directly when a token needs custom parsing, such as
//   integer literals.
//   - MYLANG_SYMBOL_TOKEN(Name, Spelling)
//     Defines a symbol which has the provided spelling, such as `*`. Spellings
//     must be unique.
//     - MYLANG_OPENING_GROUP_SYMBOL_TOKEN(Name, Spelling, ClosingName)
//     - MYLANG_CLOSING_GROUP_SYMBOL_TOKEN(Name, Spelling, OpeningName)
//       These two macros together define matches opening and closing symbols,
//       such as `(` and `)`, and create an association between the two.
//   - MYLANG_KEYWORD_TOKEN(Name, Spelling)
//     Defines a keyword which has the provided spelling, such as `if`.
//     Spellings must be unique.
//     - MYLANG_DECL_INTRODUCER_TOKEN(Name, Spelling)
//       A declaration introducer keyword, such as `fn`.
//   - MYLANG_TOKEN_WITH_VIRTUAL_NODE(TokenIndex)
//     Wrapped around one of the above _TOKEN macros, indicates that this
//     token has one additional virtual node in the parse tree.
//
// This tree represents the subset relationship between these macros, where if a
// specific x-macro isn't defined, it'll fall back to the parent macro.

#ifndef MYLANG_TOKEN
#define MYLANG_TOKEN(Name)
#endif

// The error token comes first because we want it to get the zero value, which
// will also be used in default initialization.
MYLANG_TOKEN(Error)

#ifndef MYLANG_SYMBOL_TOKEN
#define MYLANG_SYMBOL_TOKEN(Name, Spelling) MYLANG_TOKEN(Name)
#endif

#ifndef MYLANG_ONE_CHAR_SYMBOL_TOKEN
#define MYLANG_ONE_CHAR_SYMBOL_TOKEN(Name, Spelling) \
  MYLANG_SYMBOL_TOKEN(Name, Spelling)
#endif

#ifndef MYLANG_TOKEN_WITH_VIRTUAL_NODE
#define MYLANG_TOKEN_WITH_VIRTUAL_NODE(Name) Name
#endif

// TODO: Add your language's symbols here.

// Note that symbols need to be ordered from longest to shortest to effectively
// provide max-munch lexing.

// clang-format off

MYLANG_SYMBOL_TOKEN(EqualEqual,          "==")
MYLANG_SYMBOL_TOKEN(ExclaimEqual,        "!=")
MYLANG_SYMBOL_TOKEN(GreaterEqual,        ">=")
MYLANG_SYMBOL_TOKEN(LessEqual,           "<=")
MYLANG_SYMBOL_TOKEN(MinusGreater,        "->")
MYLANG_SYMBOL_TOKEN(PlusEqual,           "+=")
MYLANG_SYMBOL_TOKEN(MinusEqual,          "-=")
MYLANG_SYMBOL_TOKEN(StarEqual,           "*=")
MYLANG_SYMBOL_TOKEN(SlashEqual,          "/=")

MYLANG_SYMBOL_TOKEN(Amp,                 "&")
MYLANG_SYMBOL_TOKEN(Caret,               "^")
MYLANG_SYMBOL_TOKEN(Colon,               ":")
MYLANG_SYMBOL_TOKEN(Equal,               "=")
MYLANG_SYMBOL_TOKEN(Exclaim,             "!")
MYLANG_SYMBOL_TOKEN(Greater,             ">")
MYLANG_SYMBOL_TOKEN(Less,                "<")
MYLANG_SYMBOL_TOKEN(Minus,               "-")
MYLANG_SYMBOL_TOKEN(Percent,             "%")
MYLANG_SYMBOL_TOKEN(Period,              ".")
MYLANG_SYMBOL_TOKEN(Pipe,                "|")
MYLANG_SYMBOL_TOKEN(Plus,                "+")
MYLANG_SYMBOL_TOKEN(Slash,               "/")
MYLANG_SYMBOL_TOKEN(Star,                "*")
MYLANG_SYMBOL_TOKEN(Tilde,               "~")

MYLANG_ONE_CHAR_SYMBOL_TOKEN(Comma,      ",")
MYLANG_ONE_CHAR_SYMBOL_TOKEN(Semi,       ";")

// clang-format on

#ifndef MYLANG_OPENING_GROUP_SYMBOL_TOKEN
#define MYLANG_OPENING_GROUP_SYMBOL_TOKEN(Name, Spelling, ClosingName) \
  MYLANG_ONE_CHAR_SYMBOL_TOKEN(Name, Spelling)
#endif
MYLANG_OPENING_GROUP_SYMBOL_TOKEN(OpenParen, "(", CloseParen)
MYLANG_OPENING_GROUP_SYMBOL_TOKEN(OpenCurlyBrace, "{", CloseCurlyBrace)
MYLANG_OPENING_GROUP_SYMBOL_TOKEN(OpenSquareBracket, "[", CloseSquareBracket)
#undef MYLANG_OPENING_GROUP_SYMBOL_TOKEN

#ifndef MYLANG_CLOSING_GROUP_SYMBOL_TOKEN
#define MYLANG_CLOSING_GROUP_SYMBOL_TOKEN(Name, Spelling, OpeningName) \
  MYLANG_ONE_CHAR_SYMBOL_TOKEN(Name, Spelling)
#endif
MYLANG_CLOSING_GROUP_SYMBOL_TOKEN(CloseParen, ")", OpenParen)
MYLANG_CLOSING_GROUP_SYMBOL_TOKEN(CloseCurlyBrace, "}", OpenCurlyBrace)
MYLANG_CLOSING_GROUP_SYMBOL_TOKEN(CloseSquareBracket, "]", OpenSquareBracket)
#undef MYLANG_CLOSING_GROUP_SYMBOL_TOKEN

#undef MYLANG_ONE_CHAR_SYMBOL_TOKEN
#undef MYLANG_SYMBOL_TOKEN

#ifndef MYLANG_KEYWORD_TOKEN
#define MYLANG_KEYWORD_TOKEN(Name, Spelling) MYLANG_TOKEN(Name)
#endif

#ifndef MYLANG_DECL_INTRODUCER_TOKEN
#define MYLANG_DECL_INTRODUCER_TOKEN(Name, Spelling) \
  MYLANG_KEYWORD_TOKEN(Name, Spelling)
#endif

// TODO: Add your language's keywords here.

// clang-format off

MYLANG_TOKEN_WITH_VIRTUAL_NODE(
  MYLANG_DECL_INTRODUCER_TOKEN(Fn,          "fn"))
MYLANG_DECL_INTRODUCER_TOKEN(Import,      "import")
MYLANG_DECL_INTRODUCER_TOKEN(Let,         "let")
MYLANG_TOKEN_WITH_VIRTUAL_NODE(
  MYLANG_DECL_INTRODUCER_TOKEN(Var,       "var"))

MYLANG_KEYWORD_TOKEN(Break,               "break")
MYLANG_KEYWORD_TOKEN(Continue,            "continue")
MYLANG_KEYWORD_TOKEN(Else,                "else")
MYLANG_KEYWORD_TOKEN(False,               "false")
MYLANG_KEYWORD_TOKEN(If,                  "if")
MYLANG_KEYWORD_TOKEN(Return,              "return")
MYLANG_KEYWORD_TOKEN(True,                "true")
MYLANG_KEYWORD_TOKEN(While,               "while")

// clang-format on
#undef MYLANG_DECL_INTRODUCER_TOKEN
#undef MYLANG_KEYWORD_TOKEN

MYLANG_TOKEN(Identifier)
MYLANG_TOKEN(IntLiteral)
MYLANG_TOKEN(StringLiteral)
MYLANG_TOKEN(IntTypeLiteral)
MYLANG_TOKEN(FloatTypeLiteral)
MYLANG_TOKEN(FileStart)
MYLANG_TOKEN(FileEnd)

#undef MYLANG_TOKEN
#undef MYLANG_TOKEN_WITH_VIRTUAL_NODE
